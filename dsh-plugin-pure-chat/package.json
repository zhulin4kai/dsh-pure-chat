{
  "name": "dsh-plugin-pure-chat",
  "version": "0.2.10",
  "private": true,
  "type": "module",
  "description": "DSH 对话区：独立分区、按会话人格、搜索筛选和新建对话。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "displayName": "DSH-对话区",
    "description": "和工作区并列的对话区，按会话保存人格。"
  }
}
